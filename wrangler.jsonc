{
  "name": "konsensomat",
  "main": "src/worker.js",
  // Standard: Deployment auf der eigenen workers.dev-Adresse. Fuer eine eigene
  // Domain "workers_dev" auf false setzen und einen routes-Eintrag ergaenzen
  // (Beispiel im README unter "Selbst betreiben") — sonst bleibt workers.dev
  // eine zweite Tuer, an der ein Access-Schutz der Domain vorbeigeht.
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-04-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ABSTIMMUNG", "class_name": "Abstimmung" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Abstimmung"] }
  ]
}
