{
  "name": "konsensomat",
  "main": "src/worker.js",
  // Standard: Deployment auf der eigenen workers.dev-Adresse. Fuer eine eigene
  // Domain "workers_dev" auf false setzen und einen routes-Eintrag ergaenzen
  // (Beispiel im README unter "Selbst betreiben") — sonst bleibt workers.dev
  // eine zweite Tuer, an der ein Access-Schutz der Domain vorbeigeht.
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-04-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      // Keine automatischen Request-Logs: die trugen die volle URL und damit
      // den Zugangscode (?c=...) im Klartext. Ein "redact_query_string" gibt
      // es in wrangler nicht; Fehler und eigene Logs bleiben erfasst.
      "invocation_logs": false
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ABSTIMMUNG", "class_name": "Abstimmung" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Abstimmung"] }
  ]
}
